        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
          },
          "content": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "categoryIds": {
            "type": "array",
            "items": {
              "type": "integer",
